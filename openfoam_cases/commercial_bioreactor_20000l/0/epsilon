FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      epsilon;
}

dimensions      [0 2 -3 0 0 0 0];
internalField   uniform 0.005;

boundaryField
{
    tankWalls
    {
        type            epsilonWallFunction;
        value           uniform 0.005;
    }
    headspaceTop
    {
        type            inletOutlet;
        inletValue      uniform 0.005;
        value           uniform 0.005;
    }
}
