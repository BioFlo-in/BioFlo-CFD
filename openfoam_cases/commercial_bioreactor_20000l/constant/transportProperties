FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}

phases (water air);

water
{
    transportModel  Newtonian;
    nu              2.45e-06; // Broth viscosity (2.5x water)
    rho             1020;
}

air
{
    transportModel  Newtonian;
    nu              1.48e-05;
    rho             1.20;
}

sigma           0.070;
