FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}

defaultFieldValues
(
    volScalarFieldValue alpha.water 0
);

regions
(
    boxToCell
    {
        box (-2.0 -2.0 -0.5) (2.0 2.0 4.80);
        fieldValues
        (
            volScalarFieldValue alpha.water 1
        );
    }
);
