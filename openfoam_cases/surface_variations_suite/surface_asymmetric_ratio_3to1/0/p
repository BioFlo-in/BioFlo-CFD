FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    topWall { type zeroGradient; }
    rightWall { type zeroGradient; }
    bottomWall { type zeroGradient; }
    leftWall { type zeroGradient; }
    frontAndBack { type empty; }
}

